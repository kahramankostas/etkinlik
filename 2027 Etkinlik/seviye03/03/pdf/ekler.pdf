         <dc:format>application/postscript</dc:format>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Back to school lettering on yellow ribbon with supplies</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Back to school lettering on yellow ribbon with supplies. Offer or sale advertising design. Handwritten text, calligraphy. For leaflets, brochures, invitations, posters or banners.</rdf:li>
            </rdf:Alt>
         </dc:description>
